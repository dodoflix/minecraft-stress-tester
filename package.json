{
  "name": "minecraft-stress-tester-monorepo",
  "version": "1.3.0",
  "private": true,
  "description": "Monorepo for minecraft-stress-tester: core engine + CLI, control-plane server, and web UI.",
  "type": "module",
  "license": "MIT",
  "author": "dodo",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/ui"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start": "tsx packages/core/src/cli.ts",
    "mcst": "tsx packages/core/src/cli.ts",
    "server": "node scripts/dev-server.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/integration.test.ts'",
    "test:integration": "vitest run packages/core/test/integration.test.ts --testTimeout=200000",
    "test:coverage": "vitest run --coverage --exclude '**/integration.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/ui/tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "^5.0.0",
    "lefthook": "^2.1.12",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
